# Credenciales de Mailbox — COPIA este archivo como env.local y NO lo versiones.
#
# Se instala en el servidor en /etc/mailbox.env con permisos 600 root:root:
#   sudo install -m 600 -o root -g root /dev/null /etc/mailbox.env
#   sudo nano /etc/mailbox.env
#
# Estas NO son las mismas variables que usa el CI. En el esquema de Debian el
# secreto vive SOLO en el servidor: el job que construye la imagen no necesita la
# contraseña de la base, porque `docker build` no se conecta a ella. Eso evita
# que el secreto esté en GitHub y además evita la tag SETENV de sudo, que
# /etc/sudoers.d/deploy-docker no tiene.

HUB_DB_SERVER=10.188.141.15
HUB_DB_USER=sa
HUB_DB_PASSWORD=
HUB_DB_DATABASE=ECCSA_Admon

# Opcionales. Sin esto la app corre igual: el backend genera el par VAPID y lo
# guarda en HUB_Config. Se fijan aquí solo si se quiere la llave fuera de la base
# (por ejemplo, para poder rotarla sin tocar la base).
#VAPID_PRIVATE_KEY=
#VAPID_PUBLIC_KEY=